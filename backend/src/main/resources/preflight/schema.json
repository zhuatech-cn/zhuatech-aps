{
  "slug": "aps",
  "title": "工序产能与排程日期预检",
  "fields": [
    {
      "key": "job_no",
      "label": "工序单",
      "type": "ID",
      "length": 200
    },
    {
      "key": "resource",
      "label": "资源",
      "type": "ID",
      "length": 200
    },
    {
      "key": "required_hours",
      "label": "需求工时",
      "type": "DECIMAL",
      "length": 200,
      "scale": 2
    },
    {
      "key": "available_hours",
      "label": "可用工时",
      "type": "DECIMAL",
      "length": 200,
      "scale": 2
    },
    {
      "key": "start_date",
      "label": "开始日期",
      "type": "DATE",
      "length": 200
    },
    {
      "key": "end_date",
      "label": "结束日期",
      "type": "DATE",
      "length": 200
    }
  ],
  "unique": [
    [
      "job_no"
    ]
  ],
  "rules": [
    {
      "op": "LE",
      "args": [
        "required_hours",
        "available_hours"
      ],
      "code": "CAPACITY_SHORTAGE",
      "message": "需求工时超过该行可用产能",
      "bad": {
        "required_hours": "11"
      }
    },
    {
      "op": "DATE_LE",
      "args": [
        "start_date",
        "end_date"
      ],
      "code": "SCHEDULE_DATE",
      "message": "结束日期不得早于开始日期",
      "bad": {
        "end_date": "2026-10-31"
      }
    }
  ],
  "sampleCsv": "job_no,resource,required_hours,available_hours,start_date,end_date\nJOB-001,LINE-01,8,10,2026-11-01,2026-11-02\n",
  "limits": {
    "rows": 500,
    "bytes": 262144,
    "columns": 32,
    "cellCharacters": 4000
  },
  "scope": "Read-only batch validation; no persistence, reference-master lookup or full production certification."
}
